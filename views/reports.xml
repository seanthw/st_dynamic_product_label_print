<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_product_labels">
        <t t-call="web.html_container">
            <t t-set="body_style" t-value="'margin: 0; padding: 0;'"/>
            <body>
                <main>
                    <t t-foreach="range(page_numbers)" t-as="page_index">
                        <!-- The padding here creates the real, reliable margins -->
                        <div class="o_label_sheet" style="padding: 12.7mm 5mm;">
                            <table class="label_table" t-attf-style="border-spacing: {{horizontal_spacing}}mm {{vertical_spacing}}mm;">
                                <t t-foreach="range(rows)" t-as="row_index">
                                    <tr>
                                        <t t-foreach="range(cols)" t-as="col_index">
                                            <t t-set="label_index" t-value="page_index * labels_per_page + row_index * cols + col_index"/>
                                            <t t-set="label" t-value="labels[label_index] if label_index &lt; len(labels) else {}"/>
                                            <td class="label_cell" t-attf-style="width: {{label_width}}mm; height: {{label_height}}mm;">
                                                <div t-if="label.get('product_name')" class="o_label_full">
                                                    <div class="o_label_name" t-attf-style="font-size: {{ label.get('font_size') }};"><t t-esc="label['product_name']"/></div>
                                                    <div t-if="show_attributes and label['attribute_string']" class="attribute-string"><t t-esc="label['attribute_string']"/></div>
                                                    <div class="o_label_data">
                                                        <div t-if="show_barcode and label['barcode']">
                                                            <div t-out="label['barcode']" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 500, 'height': 80, 'margin': 0, 'humanreadable': 1 if show_barcode_digits else 0, 'img_style': 'max-width: 100%; height: auto; max-height: 40px;'}"/>
                                                        </div>
                                                        <div t-if="show_internal_ref" class="internal-ref">Code: <t t-esc="label['default_code']"/></div>
                                                        <div t-if="show_stock_label" class="stock-label">
                                                            Label <t t-esc="label['sequence']"/> of <t t-esc="label['total_quantity']"/>
                                                            <span t-if="show_on_hand_qty"> | Stock: <t t-esc="label['on_hand_qty']"/></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </t>
                </main>
            </body>
        </t>
    </template>

    <record id="action_report_product_labels" model="ir.actions.report">
        <field name="name">Product Labels</field>
        <field name="model">product.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">st_dynamic_product_label_print.report_product_labels</field>
        <field name="report_file">st_dynamic_product_label_print.report_product_labels</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="st_dynamic_product_label_print.paperformat_label"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
