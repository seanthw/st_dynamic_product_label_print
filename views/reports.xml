<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_product_labels">
        <t t-call="web.html_container">
            <style>
                .label-page {
                    width: 100%;
                    margin: 0;
                    padding: 0; /* Margins are handled by @page context */
                    page-break-after: always;
                    break-after: page;
                    background-color: white;
                }
                .label-row {
                    display: flex;
                    width: 100%;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                .label-item {
                    flex: 1;
                    height: 25.3mm;
                    box-sizing: border-box;
                    overflow: hidden;
                    text-align: center;
                    padding: 1mm;
                }
            </style>
            <t t-foreach="pages" t-as="page">
                <div class="label-page">
                    <t t-foreach="page" t-as="row">
                        <div class="label-row" t-attf-style="column-gap: {{ horizontal_spacing }}mm; margin-bottom: {{ vertical_spacing }}mm;">
                            <t t-foreach="row" t-as="label">
                                <div class="label-item">
                                    <t t-if="label">
                                         <div style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                                             <!-- Top section -->
                                             <div style="width: 100%;">
                                                 <div t-attf-style="font-weight: bold; font-size: {{ product_name_font_size }}px; line-height: 1.1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                                     <t t-esc="label['product_name']"/>
                                                 </div>
                                                 <div t-if="show_attributes and label['attribute_string']" t-attf-style="font-size: {{ product_attribute_font_size }}px; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                     <t t-esc="label['attribute_string']"/>
                                                 </div>
                                             </div>
                                             <!-- Center section (Barcode) -->
                                             <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center; min-height: 0;">
                                                <div t-if="show_internal_ref" t-attf-style="font-size: {{ label.get('font_size', 8) * 0.7 }}px;">
                                                  Code: <t t-esc="label['default_code']"/>
                                                </div>
                                                <div t-if="label['barcode']" style="width: 100%;">
                                                    <div style="padding: 1px 0;">
                                                        <div t-out="label['barcode']" t-options="{&apos;widget&apos;: &apos;barcode&apos;, &apos;symbology&apos;: &apos;Code128&apos;, &apos;width&apos;: 600, &apos;height&apos;: barcode_height, &apos;img_style&apos;: &apos;width: 85%; height: auto; display: block; margin: auto;&apos;}"></div>
                                                    </div>
                                                    <div t-if="show_barcode_digits" t-attf-style="font-size: {{ label.get('font_size', 8) * 0.8 }}px; line-height: 1;">
                                                        <t t-esc="label['barcode']"/>
                                                    </div>
                                                </div>
                                             </div>
                                             <!-- Bottom section -->
                                             <div t-if="show_stock_label or show_on_hand_qty" t-attf-style="font-size: {{ label.get('font_size', 8) * 0.7 }}px; color: #666; line-height: 1;">
                                                 <span t-if="show_stock_label">L <t t-esc="label['sequence']"/>/<t t-esc="label['total_quantity']"/></span>
                                                 <span t-if="show_on_hand_qty"> | Stock: <t t-esc="label['on_hand_qty']"/></span>
                                             </div>
                                         </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_product_labels" model="ir.actions.report">
        <field name="name">Product Labels</field>
        <field name="model">product.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">st_dynamic_product_label_print.report_product_labels</field>
        <field name="report_file">st_dynamic_product_label_print.report_product_labels</field>
        <field name="paperformat_id" ref="st_dynamic_product_label_print.paperformat_label_letter_custom"/>
    </record>
</odoo>